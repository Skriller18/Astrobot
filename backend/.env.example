# ---------------------------------------------------------------------------
# MyNaksh backend configuration
#
# Copy to .env and fill in what you have. EVERY value is optional: with an
# empty file the app runs on the mock LLM provider and the in-process stores,
# and the full test suite still passes.
#
# A real environment variable always wins over a line in this file.
# ---------------------------------------------------------------------------

# --- LLM providers ---------------------------------------------------------
# Set whichever you have. Providers without a key are shown as unavailable in
# the UI's Settings panel and are skipped by the fallback chain.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Ollama runs locally and needs no key -- only the URL if it is not the default.
OLLAMA_URL=http://localhost:11434
# Set to use Ollama Cloud (ollama.com) instead of a local daemon.
OLLAMA_API_KEY=

# Provider used when a request does not name one. Blank = walk the chain below.
LLM_PROVIDER=

# Order to try on failure. Blank = anthropic,openai,gemini,openrouter,ollama,mock
LLM_FALLBACK=

# --- Shared Brain (Neo4j) --------------------------------------------------
# docker compose up -d neo4j   ->   browse at http://localhost:7474
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=astrobot123

# --- Sessions (MongoDB) ----------------------------------------------------
MONGO_URI=mongodb://localhost:27017

# --- Storage mode ----------------------------------------------------------
# Leave as-is to use the real databases, falling back to in-process stores
# automatically if they are unreachable. Set either to "memory" to force the
# in-process store and skip the connection attempt entirely.
BRAIN=neo4j
SESSIONS=mongo
